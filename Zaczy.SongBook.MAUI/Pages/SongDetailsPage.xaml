<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:Zaczy.SongBook.MAUI.ViewModels"
    xmlns:data="clr-namespace:Zaczy.SongBook.Data;assembly=Zaczy.SongBook"
    xmlns:pages="clr-namespace:Zaczy.SongBook.MAUI.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    
    x:Class="Zaczy.SongBook.MAUI.Pages.SongDetailsPage"
    x:Name="Root"
    x:DataType="pages:SongDetailsPage"
    BackgroundColor="White"
    Title="{Binding Source={x:Reference Root}, Path=Song.Title}">

    <ContentPage.Triggers>
        <DataTrigger TargetType="ContentPage" Binding="{Binding Source={x:Reference Root}, Path=UserViewModel.LyricsDarkMode}" Value="True">
            <Setter Property="BackgroundColor" Value="{StaticResource LyricsDarkBackground}" />
        </DataTrigger>
    </ContentPage.Triggers>
    
    <Grid Padding="{OnIdiom '12,0,12,0', Phone='8,0,6,0'}" 
          RowDefinitions="Auto,Auto,Auto,Auto,*" 
          x:DataType="data:SongEntity">
        <Grid Grid.Row="0" Padding="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnIdiom 20, Tablet=40}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{OnIdiom 20, Tablet=40}" />
            </Grid.ColumnDefinitions>
           
            <Button 
                    Grid.Row="0"
                    Grid.Column="0"
                    x:Name="BackButton"
                    Text="&#xFFE9;"
                    WidthRequest="36"
                    HeightRequest="36"
                    Clicked="OnBackClicked"
                    Background="Transparent"
                    FontSize="{OnIdiom 30, Tablet=36}"
                    Padding="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    TextColor="#AAA"
                    IsVisible="True" 
                    Margin="{OnIdiom '-17,-3,0,0', Tablet='-5,-15,0,0'}"
                    />
            <Label 
                x:Name="TitleLabel" 
                Grid.Row="0" 
                Text="{Binding Source={x:Reference Root}, Path=Song.Title}"
                VerticalOptions="Center"
                Grid.Column="1"
                x:DataType="pages:SongDetailsPage"
                FontAttributes="Bold" 
                Margin="{OnIdiom 0, Tablet='0,5,0,10'}"
                FontSize="{OnIdiom Phone=20, Tablet=24, Desktop=24}"
                TextColor="#962610" >
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=UserViewModel.LyricsDarkMode}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource LyricsDarkChords}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label 
                Grid.Row="0" 
                Grid.Column="2"
                VerticalOptions="Center"
                Text="{Binding Artist}" 
                FontSize="{OnIdiom Phone=12, Tablet=18, Desktop=20}"
                TextColor="Gray" 
                Padding="{OnIdiom '0,0,-3,0',Tablet='0,0,3,0'}"
                />
            <Button 
                Grid.Row="0"
                Grid.Column="3"
                WidthRequest="24"
                HeightRequest="24" 
                x:Name ="ScrollToggleQuick"
                Clicked="OnScrollToggleClicked"
                Background="Transparent"
                VerticalOptions="Center"
                TextColor="Black"
                FontSize="10"
                Padding="0,0,0,0"
                HorizontalOptions="End"
                Margin="{OnIdiom '0,0,-9,0', Tablet='0,0,0,0'}"
                x:DataType="pages:SongDetailsPage"
                mi:MauiIcon.Value="{Binding Source={x:Reference Root}, Path=UserViewModel.PlayIcon}"
                MinimumHeightRequest="30"
                MinimumWidthRequest="30"
                />
        </Grid>

        <BoxView Grid.Row="3" HeightRequest="1" BackgroundColor="#ddd" />

        <WebView Grid.Row="4"
             x:Name="LyricsWebView"
             />

        <!-- Obszar dotyku prawej krawędzi — wywołuje pokazanie suwaka prędkości -->
        <BoxView
            x:Name="RightEdgeTouchArea"
            Grid.Row="4"
            WidthRequest="30"
            HorizontalOptions="End"
            VerticalOptions="Fill"
            BackgroundColor="Transparent"
            x:DataType="pages:SongDetailsPage">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRightEdgeTapped" NumberOfTapsRequired="2" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Panel pionowego suwaka prędkości przewijania -->
        <Border
            x:Name="SpeedSliderPanel"
            Grid.Row="4"
            WidthRequest="56"
            HorizontalOptions="End"
            VerticalOptions="Fill"
            BackgroundColor="#CC000000"
            StrokeThickness="0"
            IsVisible="False"
            Opacity="0"
            x:DataType="pages:SongDetailsPage"
            Margin="0,0,-4,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12,0,0,12" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto" Padding="4,12,4,12">

                <!-- Etykieta górna: max -->
                <Label Grid.Row="0"
                       Text="▲"
                       FontSize="10"
                       TextColor="#888"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4"/>

                <!-- Pionowy suwak (obrócony Slider) -->
                <Slider
                    x:Name="SpeedSlider"
                    Grid.Row="1"
                    Minimum="0.5"
                    Maximum="3.0"
                    Value="1.0"
                    Rotation="270"
                    WidthRequest="160"
                    HeightRequest="44"
                    MinimumTrackColor="{StaticResource Primary}"
                    MaximumTrackColor="#555"
                    ThumbColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    ValueChanged="OnSpeedSliderValueChanged"
                    x:DataType="pages:SongDetailsPage"
                    />

                <!-- Etykieta wartości -->
                <Label
                    x:Name="SpeedSliderLabel"
                    Grid.Row="2"
                    Text="1.0×"
                    FontSize="10"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Overlay z opisem suwaka — pojawia się i znika razem z suwakiem -->
        <Border
            x:Name="SpeedSliderTooltip"
            Grid.Row="4"
            HorizontalOptions="End"
            VerticalOptions="Start"
            BackgroundColor="#CC000000"
            StrokeThickness="0"
            IsVisible="False"
            Opacity="0"
            Padding="10,6"
            Margin="0,12,64,0"
            x:DataType="pages:SongDetailsPage">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label
                Text="Dostosuj prędkość przewijania tekstu"
                FontSize="11"
                TextColor="White"
                HorizontalTextAlignment="Center"
                InputTransparent="True" />
        </Border>

        <HorizontalStackLayout 
            x:Name="DeezerStatus"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.Row="4" 
            HeightRequest="30" 
            VerticalOptions="End"
            HorizontalOptions="Center"
            WidthRequest="300"
            Padding="10,5,10,5"
            x:DataType="pages:SongDetailsPage"
            IsVisible="{ Binding Source={x:Reference Root}, Path=UserViewModel.DeezerPlayerEnabled}">
            <Label 
                Text="{ Binding Source={x:Reference Root}, Path=UserViewModel.DeezerStatusInfo}"
                FontSize="9"
                HorizontalTextAlignment="Center"
                Opacity="0.15"
                />
        </HorizontalStackLayout>

        <HorizontalStackLayout 
            x:Name="DeezerPlayer"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.Row="4" 
            HeightRequest="60" 
            WidthRequest="60" 
            VerticalOptions="End"
            HorizontalOptions="End"
            Padding="10,15,10,15"
            x:DataType="pages:SongDetailsPage"
            IsVisible="{ Binding Source={x:Reference Root}, Path=UserViewModel.DeezerPlayerActive}">
            <ImageButton
                x:Name="DeezerPlayBtn"
                MinimumWidthRequest="40"
                MinimumHeightRequest="40"
                Margin="0,0,0,00"
                Opacity="0.1"
                Clicked="OnPlayDeezerClicked"
                mi:MauiIcon.Value="{Binding Source={x:Reference Root}, Path=UserViewModel.DeezerPlayIcon}">
            </ImageButton>
        </HorizontalStackLayout>

        <BoxView 
            x:Name="TopTouchArea"
            Grid.Row="0"
            Grid.ColumnSpan="1"
            Grid.RowSpan="3"
            HeightRequest="{OnIdiom 45, Tablet=53}"
            VerticalOptions="Start"
            BackgroundColor="Transparent"
            Opacity="0.6"
            Margin="{OnIdiom '20,0,30,0', Tablet='40,0,30,0'}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTopTouched" NumberOfTapsRequired="1" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <HorizontalStackLayout x:Name="ControlsPanel"
                           Grid.Row="0"
                           Grid.RowSpan="5"
                           Padding="12"
                           Spacing="12"
                           VerticalOptions="Start"
                           BackgroundColor="#80000000"
                           IsVisible="False"
                           Margin="{OnPlatform WinUI='-10', Default='-15,0,-15,0'}"
                           HeightRequest="{OnPlatform WinUI=70, Default=60}"
                           Opacity="0">
            <ImageButton
                x:Name="ScrollToggle"
                x:DataType="pages:SongDetailsPage"
                Clicked="OnScrollTogglePanelClicked"
                BackgroundColor="Transparent"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                VerticalOptions="Start"
                mi:MauiIcon.Value="{Binding Source={x:Reference Root}, Path=UserViewModel.ToggleIcon}" />
            <ImageButton 
                Source="{mi:Fluent FontIncrease24, IconSize=30, IconColor=#FFF}"
                BackgroundColor="Transparent"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                VerticalOptions="Start"
                Clicked="OnIncreaseFontClicked" 
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}" />
            <ImageButton 
                Source="{mi:Fluent FontDecrease24, IconSize={OnIdiom 25, Phone=18}, IconColor=#FFF}"
                BackgroundColor="Transparent"
                HeightRequest="{OnIdiom Default=25, Phone=18}"
                WidthRequest="{OnIdiom Default=25, Phone=18}"
                MinimumHeightRequest="{OnIdiom Default=25, Phone=18}"
                MinimumWidthRequest="{OnIdiom Default=25, Phone=18}"
                VerticalOptions="Start"
                Clicked="OnDecreaseFontClicked" />
            <ImageButton 
                Source="{mi:Fluent ApprovalsApp20, IconSize=30, IconColor=#FFF}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                BackgroundColor="Transparent"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                Clicked="OnResetFontClicked" 
                VerticalOptions="Start" />
            <ImageButton
                Source="{mi:Fluent MusicNote2Play20, IconSize=30, IconColor=#FFF}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                BackgroundColor="Transparent"
                IsVisible="Hidden"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                Clicked="OnPlayMusicClicked">
                <!--ImageButton.Triggers>
                    <DataTrigger 
                        TargetType="ImageButton"
                        Binding="{Binding HasSpotifyLink}"
                        Value="True">
                        <Setter Property="IsVisible" Value="Visible" />
                    </DataTrigger>
                </ImageButton.Triggers-->
            </ImageButton>
            <ImageButton
                Source="{mi:Fluent MusicNote2Play20, IconSize=30, IconColor=#FF0000}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                BackgroundColor="Transparent"
                IsVisible="Hidden"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                Clicked="OnPlayDeezerClicked" />
            <ImageButton
                Source="{mi:FontAwesomeSolid Gear, IconSize=30, IconColor=#FFF}"
                BackgroundColor="Transparent"
                Clicked="OnSettingsClicked"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}" />
            <ImageButton
                Source="{mi:Fluent Pen20, IconSize=30, IconColor=#FFF}"
                BackgroundColor="Transparent"
                Clicked="OnSongEditClicked"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}"
                IsVisible="{Binding HasEditPrivileges}" />
            <ImageButton
                Source="{mi:Fluent ChevronUp20, IconSize=30, IconColor=#FFF}"
                BackgroundColor="Transparent"
                Clicked="OnToneUpClicked"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}" />
            <ImageButton
                Source="{mi:Fluent ChevronDown20, IconSize=30, IconColor=#FFF}"
                BackgroundColor="Transparent"
                Clicked="OnToneDownClicked"
                VerticalOptions="Start"
                Margin="{OnIdiom Default='5,0,0,0', Tablet='20,0,0,0'}"
                MinimumHeightRequest="{OnIdiom Default=32, Phone=22}"
                MinimumWidthRequest="{OnIdiom Default=32, Phone=22}" />
        </HorizontalStackLayout>

        <!-- Obszar dotyku lewego dolnego rogu — wywołuje pokazanie przycisku SendSongToListeners -->
        <BoxView
            x:Name="BottomLeftTouchArea"
            Grid.Row="4"
            WidthRequest="60"
            HeightRequest="60"
            HorizontalOptions="Start"
            VerticalOptions="End"
            BackgroundColor="Transparent"
            x:DataType="pages:SongDetailsPage">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBottomLeftTapped" NumberOfTapsRequired="1" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Przycisk wysyłania piosenki do słuchaczy — pojawia się na 5 sekund po dotknięciu rogu -->
        <Border
            x:Name="SendToListenersPanel"
            Grid.Row="4"
            HorizontalOptions="Start"
            VerticalOptions="End"
            BackgroundColor="#CC000000"
            StrokeThickness="0"
            IsVisible="False"
            Opacity="0"
            Padding="10,8"
            Margin="8,0,0,8"
            x:DataType="pages:SongDetailsPage">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <ImageButton
                x:Name="SendToListenersBtn"
                Source="{mi:Fluent Wifi120, IconSize=28, IconColor=#FFF}"
                BackgroundColor="Transparent"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                Clicked="OnSendSongToListenersClicked" />
        </Border>
    </Grid>
</ContentPage>
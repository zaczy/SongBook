<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Zaczy.SongBook.MAUI.ViewModels"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:Zaczy.SongBook;assembly=Zaczy.SongBook"
    xmlns:data="clr-namespace:Zaczy.SongBook.Data;assembly=Zaczy.SongBook"
    xmlns:pages="clr-namespace:Zaczy.SongBook.MAUI.Pages"
    x:DataType="vm:SongListViewModel"            
    x:Class="Zaczy.SongBook.MAUI.Pages.SongsPage"
    x:Name="Root"
    Title="Piosenki">

    <ContentPage.ToolbarItems>
        <!-- Menu / Toolbar item that triggers import from API -->
        <!--ToolbarItem Text="Import" Command="{Binding FetchCommand}" Order="Primary" Priority="0" /-->
        <ToolbarItem Text="Katalogi piosenek" Command="{Binding CategoriesCommand}" Order="Primary" Priority="0" />
        <ToolbarItem Command="{Binding CategoriesCommand}" Order="Primary" Priority="0" IconImageSource="collect_ico.png" />
        <ToolbarItem Command="{Binding SettingsPageCommand}" 
                     Order="Primary" 
                     Priority="2" 
                     IconImageSource="gear_white_transparent.png" 
                     />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Filters -->
            <StackLayout 
                Orientation="Horizontal" 
                Spacing="8" 
                Grid.Row="0"
                Background="{AppThemeBinding Light=#D6C6C0, Dark=#100707}"
                Padding="12"
                >
                <Entry Placeholder="Tytuł lub wykonawca"
                       HorizontalOptions="FillAndExpand"
                       Text="{Binding TitleFilter}"
                       PlaceholderColor="{AppThemeBinding Light=#FFF, Dark=#FFF}"
                       Completed="OnTitleFilterCompleted" />
                <ImageButton 
                    Source="{mi:Fluent Search20, IconSize=20, IconColor={AppThemeBinding Light=#761610, Dark=#b66650}}"
                    Command="{Binding FilterCommand}"
                    HorizontalOptions="End"
                    MinimumHeightRequest="32"
                    MinimumWidthRequest="32"
                    BackgroundColor="Transparent"
                    />
                <ImageButton 
                    Source="{mi:Fluent FilterDismiss20, IconSize=20, IconColor={AppThemeBinding Light=#761610, Dark=#b66650}}"
                    Command="{Binding ClearCommand}"
                    HorizontalOptions="End"
                    MinimumHeightRequest="32"
                    MinimumWidthRequest="32"
                    BackgroundColor="Transparent"
                    />
                <!--<ImageButton 
                    Source="{mi:Fluent ArrowClockwise20, IconSize=20, IconColor=#999}"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="End"
                    MinimumHeightRequest="28"
                    MinimumWidthRequest="28"
                    BackgroundColor="Transparent"
                    />
                <ImageButton 
                    Source="{mi:FluentFilled Settings20Filled, IconSize=20, IconColor=#999}"
                    Command="{Binding SettingsPageCommand}"
                    HorizontalOptions="End"
                    MinimumHeightRequest="16"
                    MinimumWidthRequest="16"
                    BackgroundColor="Transparent"
                    />-->
            </StackLayout>
            
            <!-- Empty state message -->
            <Label Grid.Row="3"
                   Text="Brak piosenek do wyświetlenia. Przejdź do 'Katalogi piosenek' i wybierz jeden lub więcej katalogów piosenek do pobrania z serwera."
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="20"
                   FontSize="14"
                   Opacity="0.5"
                   IsVisible="{Binding IsEmptySongs}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding TitleFilterNotEmpty}" Value="True">
                        <Setter Property="Text" Value="Nie znaleziono piosenek zawierających podaną frazę. Usuń filtr lub wprowadź inne kryterium wyszukiwania" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Lista propozycji zmiany piosenki (widoczna dla Dyrygenta) -->
            <Border
                x:Name="SongProposalsList"
                Grid.Row="2"
                Grid.RowSpan="1"
                IsVisible="{Binding UserViewModel.PendingProposedSongsExist}"
                BackgroundColor="#761610"
                Grid.ColumnSpan="4"
                StrokeThickness="0"
                Opacity="1"
                Padding="8,6"
                Margin="0,2,0,20"
                ZIndex="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <!--<Border.Background>
                    <SolidColorBrush Color="{StaticResource Primary}" />
                </Border.Background>--> 
                <!--<Border.Triggers>
                    <DataTrigger TargetType="Border" 
                                 Binding="{Binding Source={x:Reference Root}, Path=UserViewModel.PendingProposedSongsExist}" 
                                 Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Border.Triggers>-->

                <Grid RowDefinitions="Auto,Auto">
                    <!-- Nagłówek -->
                    <Label
                        Grid.Row="0"
                        Text="{Binding UserViewModel.PendingProposedSongs.Count, StringFormat='Propozycje ({0})'}"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#90EE90"
                        Margin="4,0,0,4" />

                    <!-- Lista propozycji -->
                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding UserViewModel.PendingProposedSongs}"
                        MaximumHeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:SongEntity">
                                <Grid 
                                    ColumnDefinitions="*,Auto,Auto" 
                                    Padding="4,3"
                                    BackgroundColor="#22FFFFFF"
                                    Margin="0,2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProposalItemTapped"  NumberOfTapsRequired="1"/>
                                    </Grid.GestureRecognizers>

                                    <!-- Informacja o piosence -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding Artist}"
                                            FontSize="11"
                                            TextColor="#CCC"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Przycisk akceptacji -->
                                    <ImageButton
                                        Grid.Column="1"
                                        Source="{mi:Fluent Checkmark24, IconSize=20, IconColor=#90EE90}"
                                        BackgroundColor="Transparent"
                                        MinimumHeightRequest="36"
                                        MinimumWidthRequest="36"
                                        Margin="4,0,0,0"
                                        Clicked="OnSongProposalAccepted"
                                        CommandParameter="{Binding .}" />

                                    <!-- Przycisk odrzucenia -->
                                    <ImageButton
                                        Grid.Column="2"
                                        Source="{mi:Fluent Dismiss24, IconSize=20, IconColor=#FF6B6B}"
                                        BackgroundColor="Transparent"
                                        MinimumHeightRequest="36"
                                        MinimumWidthRequest="36"
                                        Margin="2,0,0,0"
                                        Clicked="OnSongProposalRejected"
                                        CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>


            <!-- List -->
            <CollectionView ItemsSource="{Binding Songs}" 
                            SelectionMode="Single" 
                            Grid.Row="3" 
                            x:Name="SongsCollection" 
                            Margin="12,20,12,10"
                            IsVisible="{Binding HasSongs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:SongEntity">
                        <Grid Margin="0,0" Padding="0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- content -->
                          </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" Padding="15,10,10,10" BackgroundColor="{Binding CategoryColor}" Margin="0,0,0,10">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Artist}" FontSize="Small" TextColor="Gray" />
                            </StackLayout>

                          <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" CommandParameter="{Binding .}" />
                          </Grid.GestureRecognizers>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                Grid.Row="4"
                Margin="0,0,0,10"
                >
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding UserViewModel.EnableEdgeToEdge}" Value="True">
                        <Setter Property="Margin" Value="{Binding BottomNavigationMargin}" />
                    </DataTrigger>
                </Grid.Triggers>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
            <Entry 
                Grid.Column="0"
                Placeholder="'Która strona?' :)"
                Text="{Binding PageFilter}"
                Keyboard="Numeric"
                Completed="OnPageFilterCompleted" 
                IsVisible="{Binding HasSongs}"
                Margin="10,0,10,0"
                VerticalOptions="End"
                HorizontalOptions="End"
                WidthRequest="150"
                />


                <ImageButton
                    x:Name="GroupsButton"
                    mi:MauiIcon.Value="{Binding ListeningGroupIcon}"
                    Grid.Row="3"
                    HorizontalOptions="End"
                    MinimumHeightRequest="22"
                    MinimumWidthRequest="22"
                    BackgroundColor="Transparent"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    IsVisible="{Binding UserViewModel.GroupModeActive}"
                    Clicked="GroupsButton_Clicked"
                    />


            </Grid>

            <!-- Overlay loading indicator bound to VM.IsBusy -->
            <AbsoluteLayout Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsBusy}" Opacity="0.3">
                <BoxView AbsoluteLayout.LayoutBounds="0,0,1,1"
                         AbsoluteLayout.LayoutFlags="All"
                         Color="{AppThemeBinding Light=#FFF, Dark=#000}"
                         IsVisible="{Binding IsBusy}" />

                <ActivityIndicator AbsoluteLayout.LayoutBounds="0.5,0.5,48,48"
                                   AbsoluteLayout.LayoutFlags="PositionProportional"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
            </AbsoluteLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
<mah:MetroWindow x:Class="Zaczy.SongBook.WPF.Pages.LayoutEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="Edytor domyœlnego layoutu piosenek"
                 Height="800" Width="1100"
                 WindowStartupLocation="CenterOwner"
                 Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Panel opcji -->
        <Border Grid.Row="0" Padding="12" Background="#F2F2F2" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Czcionka -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Czcionka:" Margin="4" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                          x:Name="FontFamilyCombo"
                          Margin="4" MinWidth="200"
                          SelectionChanged="Option_Changed" />

                <!-- Rozmiar tekstu piosenki -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rozmiar tekstu (px):" Margin="4" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1"
                        x:Name="FontSizeSlider"
                        Minimum="10" Maximum="48" Value="18"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Margin="4" VerticalAlignment="Center"
                        ValueChanged="Option_ValueChanged" />
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat=N0}"
                           Margin="4" VerticalAlignment="Center" />

                <!-- Kolor tekstu -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Kolor tekstu (#RRGGBB):" Margin="4" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="TextColorBox"
                         Text="#000000"
                         Margin="4"
                         TextChanged="Option_TextChanged" />

                <!-- Kolor akordów -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kolor akordów (#RRGGBB):" Margin="4" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         x:Name="ChordColorBox"
                         Text="#0055AA"
                         Margin="4"
                         TextChanged="Option_TextChanged" />

                <!-- Opcje bool -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Margin="4">
                    <CheckBox x:Name="SkipTabsCheck" Content="Pomiñ tabulatury" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="ChordsAboveLyricsCheck" Content="Akordy nad tekstem" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="CustomChordsOnlyCheck" Content="Tylko w³asne akordy"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Podgl¹d -->
        <wv2:WebView2 Grid.Row="1" x:Name="PreviewWebView" />

        <!-- Dolne przyciski -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="Wylosuj inn¹ piosenkê" Padding="10,4" Margin="4" Click="RandomSong_Click" />
            <Button Content="Zapisz jako domyœlne" Padding="10,4" Margin="4" Click="Save_Click" />
            <Button Content="Zamknij" Padding="10,4" Margin="4" Click="Close_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
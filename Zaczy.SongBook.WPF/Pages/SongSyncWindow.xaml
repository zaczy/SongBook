<mah:MetroWindow x:Class="Zaczy.SongBook.WPF.Pages.SongSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zaczy.SongBook.WPF.Pages"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        Title="Synchronizacja piosenek" Height="600" Width="900">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </mah:MetroWindow.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Różnice względem serwera"
                       Style="{DynamicResource MahApps.Styles.TextBlock.Headline}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CountLabel"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="SyncDataGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                  >

            <DataGrid.Columns>

                <!-- Checkbox wyboru -->
                <DataGridTemplateColumn Header="" Width="40" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource MahApps.Styles.CheckBox}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tytuł piosenki -->
                <DataGridTextColumn Header="Tytuł piosenki"
                                    Binding="{Binding SongTitle}"
                                    Width="250"
                                    IsReadOnly="True"/>

                <!-- Podsumowanie różnic -->
                <DataGridTextColumn Header="Różnice"
                                    Binding="{Binding FieldsSummary}"
                                    Width="*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Data lokalnie"
                                    Binding="{Binding ModifiedLocal}"
                                    Width="120"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Data API"
                                    Binding="{Binding ModifiedApi}"
                                    Width="120"
                                    IsReadOnly="True"/>


            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>

        <!-- Pasek zaznacz wszystko / odznacz wszystko -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Zaznacz wszystkie"
                    Click="SelectAll_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Padding="12,4"
                    Margin="0,0,8,0"/>
            <Button Content="Odznacz wszystkie"
                    Click="DeselectAll_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Padding="12,4"/>
            <TextBlock x:Name="SelectedCountLabel"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
        </StackPanel>

        <!-- Przyciski akcji -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Pobierz zaznaczone z serwera"
                    x:Name="SyncSelectedButton"
                    Click="SyncSelected_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Visibility="{Binding IsApiToLocal, Converter={StaticResource BoolToVisibility}}"
                    
                    />
            <Button Content="Wyślij zaznaczone na serwer"
                    x:Name="SyncUpSelectedButton"
                    Click="SyncUpSelected_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Visibility="{Binding IsLocalToApi, Converter={StaticResource BoolToVisibility}}"
                    
                    />
            <Button Content="Zamknij"
                    Click="Close_Click"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Padding="16,6"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
